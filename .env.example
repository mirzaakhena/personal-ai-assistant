# Gateway: 'whatsapp' or 'webchat'
GATEWAY=whatsapp

# WhatsApp: comma-separated phone numbers allowed to chat
WHITELIST_NUMBERS=628111222333,628444555666

# Web Chat (only if GATEWAY=webchat)
# WEBCHAT_USER_ID=your_user_id
# WEBCHAT_PORT=3000

# Claude model — REQUIRED. No silent fallback; runtime throws if unset.
# Options: 'opus', 'sonnet', 'haiku' (or full model IDs e.g. claude-sonnet-4-6).
# Runtime auth is via Claude Code subscription (claude-agent-sdk spawns the `claude` CLI).
CLAUDE_MODEL=sonnet

# Working directory for Claude agent
# CLAUDE_CWD=/home/youruser/personal-ai-assistant

# Enable vector embeddings for memory search (default: false)
# MEMORY_EMBEDDING_ENABLED=false
