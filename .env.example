# ──────────────────────────────────────────────────────────
# Personal AI Assistant — v4 env reference
# Copy to .env and adjust.
# ──────────────────────────────────────────────────────────

# ── Gateway selection ────────────────────────────────────
# 'console' for local dev / smoke tests
# 'telegram' for production bot
GATEWAY=console

# ── Claude model (REQUIRED — no silent fallback) ─────────
# Short names: 'opus' | 'sonnet' | 'haiku'
# Or full model IDs, e.g. claude-sonnet-4-6, claude-opus-4-7
# Runtime auth is via the claude-agent-sdk.
CLAUDE_MODEL=sonnet

# Optional context-window override (rarely needed; model-specific default is used otherwise)
# CLAUDE_CONTEXT_LIMIT=200000

# ── Data directory ───────────────────────────────────────
# Per-user state lives at <DATA_DIR>/users/<userId>/
# - user.db             (SQLite memory/cronjobs/tasks/habits/sessions)
# - .claude/skills/     (AI-authored skills — SDK discovery)
# - .archived-skills/   (archived, not discovered)
DATA_DIR=data

# ── Console gateway (GATEWAY=console) ────────────────────
# User id bound to the single console session
CONSOLE_USER_ID=console-user

# ── Telegram gateway (GATEWAY=telegram) ──────────────────
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat IDs allowed to message the bot.
# Anyone outside the whitelist is silently dropped.
TELEGRAM_WHITELIST=628111222333,628444555666

# ── Session summarization ────────────────────────────────
# Soft turn threshold: once crossed, the next exchange finishes, then the
# session is summarized and cleared. Lower values → tighter, higher-fidelity
# summaries but more frequent LLM calls.
SUMMARIZE_TURN_THRESHOLD=30

# Model used for session summarization (cheap/fast recommended).
SUMMARIZE_MODEL=claude-haiku-4-5

# ── Agent loop ───────────────────────────────────────────
# Max internal tool-use cycles per query before the SDK aborts with
# error_max_turns. Raise if the AI needs many tool calls for one reply
# (e.g. multi-fact save + cron + task in one go). Default 50.
MAX_TURNS=50
