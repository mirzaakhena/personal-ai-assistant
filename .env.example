# ──────────────────────────────────────────────────────────
# Personal AI Assistant — v4 env reference
# Copy to .env and adjust.
# ──────────────────────────────────────────────────────────

# ── Gateway selection ────────────────────────────────────
# 'console' for local dev / smoke tests
# 'telegram' for production bot
GATEWAY=console

# ── Claude model (REQUIRED — no silent fallback) ─────────
# Short names: 'opus' | 'sonnet' | 'haiku'
# Or full model IDs, e.g. claude-sonnet-4-6, claude-opus-4-7
# Runtime auth is via the claude-agent-sdk.
CLAUDE_MODEL=sonnet

# Optional context-window override (rarely needed; model-specific default is used otherwise)
# CLAUDE_CONTEXT_LIMIT=200000

# ── Timezone ─────────────────────────────────────────────
# IANA timezone ID used across the app (current_moment tag, cron, logs, timestamps).
# Examples: Asia/Jakarta, Asia/Seoul, America/New_York
# Default: Asia/Jakarta
TIMEZONE=Asia/Jakarta

# ── Data directory ───────────────────────────────────────
# Per-user state lives at <DATA_DIR>/users/<userId>/
# - user.db             (SQLite memory/cronjobs/tasks/habits/sessions)
# - .claude/skills/     (AI-authored skills — SDK discovery)
# - .archived-skills/   (archived, not discovered)
DATA_DIR=data

# ── Console gateway (GATEWAY=console) ────────────────────
# User id bound to the single console session
CONSOLE_USER_ID=console-user

# ── Telegram gateway (GATEWAY=telegram) ──────────────────
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat IDs allowed to message the bot.
# Anyone outside the whitelist is silently dropped.
TELEGRAM_WHITELIST=628111222333,628444555666

# ── Session reset ────────────────────────────────────────
# Soft turn threshold: once crossed, the next exchange finishes, then the
# SDK session pointer is dropped so the next turn starts fresh with a full
# wake-up briefing (containing the last N messages verbatim). No summarizer.
TURN_RESET_THRESHOLD=30

# ── Agent loop ───────────────────────────────────────────
# Max internal tool-use cycles per query before the SDK aborts with
# error_max_turns. Raise if the AI needs many tool calls for one reply
# (e.g. multi-fact save + cron + task in one go). Default 50.
MAX_TURNS=50

# ── Read-only dashboard (optional) ───────────────────────
# Mounts an HTTP server in-process at port 3200, exposing read-only
# views of all 11 stores per user. If DASHBOARD_TOKEN is empty/unset,
# the dashboard server is silently skipped — bot continues normally.
#
# Generate a strong token with: openssl rand -hex 32
# DASHBOARD_TOKEN=

# Optional override for the listen port (default: 3200).
# DASHBOARD_PORT=3200

# In-app TLS (self-signed). Generate cert + key once with:
#   ./scripts/gen-dashboard-cert.sh [server-ip-or-hostname]
# Both must be set for HTTPS; if either is unset, dashboard falls back
# to plain HTTP (acceptable for localhost dev — browsers treat
# localhost as a secure context, so the Secure cookie still works).
# Production deployments accessed remotely SHOULD set both.
# DASHBOARD_TLS_CERT=data/dashboard-tls/cert.pem
# DASHBOARD_TLS_KEY=data/dashboard-tls/key.pem

